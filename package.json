{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean": "find . \\( -name .git -prune \\) -o \\( \\( -name node_modules -o -name dist -o -name .turbo \\) -type d -prune -exec rm -rf '{}' + \\) && rm -rf out coverage logs .cache && rm -f .eslintcache && find . -maxdepth 1 -name '*.tgz' -delete && find . \\( -name .git -prune \\) -o \\( -name '*.tsbuildinfo' -type f -delete \\)",
    "typecheck": "bunx --bun tsc -p tsconfig.build.json --noEmit",
    "format": "prettier --write .",
    "check": "bun run format && bun run typecheck",
    "build": "bun run check && bun src/build",
    "start:dev": "bun --watch ./src/main.ts",
    "start:debug": "nest start --watch -e bun --debug",
    "start:prod": "NODE_ENV=production bun dist/main",
    "lint:fix": "eslint \"{src,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "jiti": "^2.7.0",
    "joi": "^18.2.8",
    "mongoose": "^9.9.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.4.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.12.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
