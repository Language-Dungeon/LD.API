{
  "compilerOptions": {
    "lib": ["ES2023"],
    "target": "ES2022",
    "module": "commonjs",
    "allowJs": true,
    "typeRoots": ["./src/types/", "./node_modules/@types"],

    /* NestJS */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "paths": {
      "@types/*": ["./src/types/*"],
      "@types": ["./src/types"],
      "@modules/*": ["./src/modules/*"],
      "@modules": ["./src/modules"],
      "@common/*": ["./src/common/*"],
      "@common": ["./src/common"],
      "@schemas/*": ["./src/schemas/*"],
      "@schemas": ["./src/schemas"]
    }
  },

  "exclude": ["node_modules", "dist"]
}
